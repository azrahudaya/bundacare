# Salin file ini jadi .env lalu isi sesuai kebutuhan.
# Nilai di bawah adalah default yang dipakai kalau barisnya tidak ada.
# Bot menolak jalan kalau ada nilai angka yang salah tulis (lihat validateEnv di index.js).

# --- Waktu dan program ---
TIMEZONE=Asia/Jakarta
REMINDER_LOG_RETENTION_DAYS=180
REMINDER_STALE_AFTER_MINUTES=30
MAX_SEND_ATTEMPTS=4

# --- Keamanan pengiriman (dipakai lib/send-guard.js) ---
# Jeda acak antar pesan. Jangan turunkan di bawah 1500 ms.
SEND_MIN_GAP_MS=3500
SEND_JITTER_MS=2500
REPLY_MIN_GAP_MS=900
REPLY_JITTER_MS=1200
# Kuota keluar global. Inilah rem yang mencegah pola broadcast.
SEND_MAX_PER_MINUTE=12
SEND_MAX_PER_HOUR=180
SEND_MAX_PER_DAY=900
SEND_MAX_QUEUE_WAIT_MS=900000
# Circuit breaker: berhenti mengirim setelah sekian kegagalan permanen berturut-turut.
SEND_FAIL_BREAKER=5
SEND_PAUSE_MS=3600000
# Jendela jam kirim untuk pengingat terjadwal (balasan percakapan tidak dibatasi).
# Ini "jam kerja" bot: pengingat hanya keluar antara jam mulai dan jam akhir.
# Default 03:00-23:59 supaya tidak ada pesan dini hari (00:00-02:59), tetapi ibu
# tetap boleh memilih jam pengingat kapan saja di dalam rentang ini.
SEND_WINDOW_START_HOUR=3
SEND_WINDOW_END_HOUR=23
SEND_WINDOW_END_MINUTE=59
# Jendela kirim juga boleh melewati tengah malam, mis. 22:00-01:55 (START=22,
# END_HOUR=1, END_MINUTE=55). START == END berarti jendela penuh 24 jam.
# PENTING: jam pengingat user divalidasi terhadap jendela ini; jam di luar jendela
# ditolak supaya tidak ada user yang diam-diam tidak pernah menerima pengingat.
# Kurva warm-up sesi baru: kuota harian lebih kecil pada 30 hari pertama.
SEND_WARMUP_ENABLED=1
SEND_WARMUP_DAY1_MAX=50
SEND_WARMUP_DAY8_MAX=150

# --- WhatsApp Web (whatsapp-web.js) ---
# Jalur Chrome asli. Kosongkan supaya dicari otomatis.
PUPPETEER_EXECUTABLE_PATH=
# Nama dan id sesi. clientId memisahkan direktori sesi, jangan diubah setelah dipakai.
WA_CLIENT_ID=bundacare
WA_DEVICE_NAME=bundacare
WA_INIT_MAX_ATTEMPTS=10
# --- Pemulihan otomatis saat sesi WhatsApp terputus (bukan LOGOUT) ---
# Library menutup browser saat `disconnected` tetapi proses tetap hidup, jadi bot
# menjadwalkan initialize() ulang dengan backoff. Kalau habis, proses keluar supaya
# systemd (Restart=always) memulai ulang dari nol.
WA_RECONNECT_MAX_ATTEMPTS=8
WA_RECONNECT_BASE_DELAY_MS=60000
WA_RECONNECT_MAX_DELAY_MS=1800000
# Versi WhatsApp Web yang dipatok (kosong = pakai versi live terbaru).
# Isi versi yang sudah terbukti jalan untuk bisa mundur saat rilis baru bermasalah.
WA_WEB_VERSION=
WA_WEB_VERSION_CACHE_DIR=
# Nomor bot untuk penautan tanpa QR, format 628xxxxxxxxxx. Kosongkan untuk pakai QR.
# Kalau diisi, kode 8 digit muncul di journal dan di data/pairing-code.txt.
WA_PAIRING_NUMBER=
# Nomor bot untuk tautan verifikasi saat pairing memakai QR, format 628xxxxxxxxxx.
PUBLIC_WA_NUMBER=
# Registrasi web tertutup sampai pilot disetujui dan HTTPS/proxy disiapkan.
PUBLIC_REGISTRATION_ENABLED=0
# Interval permintaan kode pairing baru selama belum tersambung (milidetik).
WA_PAIRING_CODE_REFRESH_MS=180000
# Set 1 kalau dijalankan sebagai root atau di dalam container tanpa sandbox.
PUPPETEER_NO_SANDBOX=0
DISABLE_CHROME_SANDBOX=0

# --- Admin WA dan akses ---
ADMIN_WA_IDS=
ALLOWLIST_WA_IDS=
# Set 1 supaya hanya nomor di allowlist yang dilayani.
ENFORCE_ALLOWLIST=1

# --- Batas pesan masuk per user (anti spam dari luar) ---
RATE_LIMIT_MAX_PER_MINUTE=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_COOLDOWN_MS=120000
POLL_MAX_RESPONSES_PER_DAY=2
POLL_RETRY_BASE_DELAY_MS=300000
POLL_RETRY_MAX_DELAY_MS=1800000

# --- Loop pengingat ---
REMINDER_LOOP_CONCURRENCY=1

# --- Admin web ---
ADMIN_WEB_ENABLED=1
# Biarkan 127.0.0.1 kalau tidak ada reverse proxy TLS. Isi 0.0.0.0 hanya di balik proxy.
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3030
ADMIN_WEB_USER=admin
# Login utama memakai MAGIC LINK lewat email. Daftar email admin yang boleh masuk,
# dipisah koma. Wajib diisi supaya tautan masuk bisa dikirim.
ADMIN_EMAILS=
# URL publik panel, dipakai untuk menyusun tautan di email (mis. https://bot.bundacare.site).
# Kalau kosong, host permintaan dipakai apa adanya.
ADMIN_WEB_PUBLIC_URL=
# Fallback darurat berbasis password. Kosongkan untuk mematikan login password.
# Kalau dikosongkan, bot membuat password acak sekali, lalu menyimpan hash-nya di tabel settings.
ADMIN_WEB_PASSWORD=
ADMIN_WEB_SESSION_TTL_MS=2592000000
# Sesi panel mati sendiri kalau tidak dipakai selama ini (default 14 hari).
ADMIN_WEB_IDLE_TIMEOUT_MS=1209600000
# Set 1 kalau admin web berada di belakang reverse proxy, supaya IP asli dipakai untuk rate limit login.
ADMIN_WEB_TRUST_PROXY=0
ADMIN_WEB_COOKIE_SECURE=0
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000

# --- Email magic link (Gmail SMTP) ---
# Pakai App Password Gmail 16 karakter, bukan password akun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Set 1 untuk menguji tanpa mengirim email nyata: pesan ditulis ke log.
SMTP_JSON_TRANSPORT=0
MAGIC_LINK_TTL_MS=900000
MAGIC_LINK_RATE_MAX_PER_EMAIL=5
MAGIC_LINK_RATE_MAX_PER_IP=10

# --- API registrasi lintas situs (landing di GitHub Pages) ---
# Origin yang boleh memanggil /api/registrations, dipisah koma.
REGISTRATION_ALLOWED_ORIGINS=https://ajra.tech,https://azrahudaya.github.io

# --- Backup harian (dipakai scripts/backup-db.js) ---
BACKUP_KEEP_DAYS=14
# Backup yang hanya ada di VPS yang sama belum aman. Isi salah satu:
BACKUP_OFFSITE_DIR=
BACKUP_REMOTE_CMD=

# --- Backup sesi WhatsApp (dipakai scripts/backup-session.js) ---
# Arsip sesi berisi kredensial tertaut: WAJIB dienkripsi. Isi passphrase di bawah.
# Tanpa passphrase, skrip menolak jalan kecuali BACKUP_SESSION_ALLOW_PLAINTEXT=1.
BACKUP_SESSION_PASSPHRASE=
BACKUP_SESSION_ALLOW_PLAINTEXT=0
BACKUP_SESSION_KEEP_DAYS=14
BACKUP_SESSION_OFFSITE_DIR=
BACKUP_SESSION_REMOTE_CMD=

# --- Ringkasan mingguan untuk operator ---
# Bot mengirim ringkasan kepatuhan tiap Senin di dalam jam kirim. Set 0 untuk mematikannya.
WEEKLY_DIGEST_ENABLED=1
# Batas waktu tiap jalur alarm (webhook dan Telegram), milidetik.
ALERT_TIMEOUT_MS=10000

# --- Alarm (dipakai sendAlert di index.js dan scripts/watchdog.js) ---
# Alarm dikirim ke tiga jalur: webhook, Telegram, dan WhatsApp admin. WhatsApp justru mati
# saat WhatsApp bermasalah, jadi isi minimal satu jalur luar.
ALERT_COOLDOWN_MS=1800000
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Hanya untuk pengujian: ganti alamat API Telegram ke server tiruan.
ALERT_TELEGRAM_API_BASE=

# --- Penjaga luar proses (dipakai scripts/watchdog.js + remindcare-watchdog.timer) ---
# Bot menulis data/heartbeat.json tiap 30 detik. Penjaga memeriksa berkas itu tiap 5 menit.
# Setelah berapa lama denyut dianggap basi.
WATCHDOG_MAX_AGE_MS=600000
# Berapa lama sesi WhatsApp boleh belum siap sebelum dianggap masalah.
WATCHDOG_NOT_READY_MS=1200000
# Jarak pengulangan alarm untuk masalah yang sama.
WATCHDOG_REPEAT_MS=21600000
WATCHDOG_SERVICE=bundacare-bot
# Set 1 hanya kalau sudoers sudah mengizinkan restart layanan ini (lihat deploy/INSTALL.md).
WATCHDOG_RESTART=0