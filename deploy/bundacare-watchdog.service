[Unit]
Description=bundacare watchdog (periksa denyut bot dari luar proses)
Documentation=file:/opt/bundacare/deploy/INSTALL.md
After=bundacare-bot.service
Wants=bundacare-bot.service

[Service]
Type=oneshot
# User dan WorkingDirectory harus sama dengan unit bot supaya berkas denyut bisa dibaca.
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/bundacare
EnvironmentFile=-/opt/bundacare/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/bundacare/scripts/watchdog.js
# Penjaga hanya membaca berkas dan mengirim HTTP keluar.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/bundacare/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bundacare-watchdog
