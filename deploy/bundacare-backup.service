[Unit]
Description=Backup harian database pregnancy-reminder-bot
After=bundacare-bot.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/bundacare
EnvironmentFile=-/opt/bundacare/.env
ExecStart=/usr/bin/node scripts/backup-db.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bundacare-backup